/* EmbeddedDSP-FX Stylesheet - Source of Truth */

Host--UI--Spectrum--SpectrumPanel {
    background-color: transparent;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 12px;
}

#SpectrumZoomIcon {
    color: #50c88c;
    font-size: 20px;
    background: transparent;
    max-width: 24px;
}

#SpectrumSensitivitySlider {
    background: transparent;
    min-width: 20px;
    max-width: 28px;
}

#SpectrumUnitLabel {
    font-size: 8pt;
    color: #888888;
    font-weight: bold;
    padding-bottom: 2px;
}

#SpectrumSensitivitySlider::groove:vertical {
    background: #1a1a1a;
    width: 4px;
    border-radius: 2px;
}

#SpectrumSensitivitySlider::handle:vertical {
    background: #50c88c;
    border: 1px solid #50c88c;
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

Host--UI--Spectrum--SpectrumView {
    background-color: transparent;
    alternate-background-color: #000000;  /* Inner Plot Area */
    border: none;
    color: #333333;                       /* Grid Lines (WindowText) */
    selection-background-color: #50c88c;  /* FFT Curve (Highlight) */
}

Host--UI--Spectrum--SpectrumAxisX, Host--UI--Spectrum--SpectrumAxisY {
    font-size: 8pt;
    color: #888888;
}

#welcomeLabel {
    font-size: 16px;
    color: #777777;
    font-weight: bold;
}

#effectItemBox {
    background-color: #252525;
    border: 1px solid #444444;
    border-radius: 6px;
}

#effectTitle {
    color: #50c88c;
    font-weight: bold;
    font-size: 10pt;
    text-transform: uppercase;
    border-bottom: 1px solid #333333;
    padding-bottom: 4px;
    margin-bottom: 4px;
}

#effectItemBox:hover {
    border: 1px solid #50c88c;
}
