/* EmbeddedDSP-FX Stylesheet */
/* Color tokens {{...}} are filled from UI/UiTheme.h at startup. */
/* #objectName selectors: see UI/UiObjectNames.h */

QComboBox {
    background-color: {{panel}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border: 1px solid {{accent}};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: {{panel}};
    color: {{text}};
    border: 1px solid {{border}};
    outline: 0;
    selection-background-color: {{accentMuted}};
    selection-color: {{text}};
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 2px 6px;
    color: {{text}};
    background-color: {{panel}};
    border: none;
    border-left: 3px solid transparent;
}

QComboBox QAbstractItemView::item:disabled {
    color: {{textMuted}};
    background-color: {{panel}};
}

QComboBox QAbstractItemView::item:disabled:hover {
    color: {{textMuted}};
    background-color: {{panel}};
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{listHover}};
    color: {{text}};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{accentMuted}};
    color: {{text}};
    border-left: 3px solid {{accent}};
}

QComboBox QAbstractItemView::item:selected:hover {
    background-color: {{accentMutedHover}};
    color: {{text}};
    border-left: 3px solid {{accent}};
}

QPushButton {
    background-color: {{panel}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 22px;
}

QPushButton:hover {
    border: 1px solid {{accent}};
    background-color: {{panelHover}};
}

QPushButton:pressed {
    background-color: {{window}};
}

QPushButton:checked {
    background-color: {{window}};
    border: 1px solid {{accent}};
    color: {{accent}};
}

#effectEqCurveButton {
    min-width: 58px;
    max-width: 58px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    color: {{accent}};
    border: 1px solid {{border}};
    background-color: {{window}};
}

#effectEqCurveButton:hover {
    border: 1px solid {{accent}};
    background-color: {{panelHover}};
}

#effectBypassButton {
    color: {{textMuted}};
    border: 1px solid {{border}};
    background-color: transparent;
    font-weight: normal;
}

#effectBypassButton:hover {
    color: {{text}};
    border: 1px solid {{accent}};
    background-color: {{panelHover}};
}

#effectBypassButton:checked {
    color: {{textDim}};
    border: 1px dashed {{border}};
    background-color: {{window}};
}

#presetBar #presetButton {
    min-width: 28px;
    max-width: 28px;
    padding: 4px 0;
}

#presetBar #presetButton:checked {
    background-color: {{accentMuted}};
    border: 1px solid {{accent}};
    color: {{accent}};
}

#presetBar #presetSaveButton {
    min-width: 56px;
    margin-left: 4px;
}

Host--UI--Spectrum--SpectrumPanel {
    background-color: transparent;
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 12px;
}

#SpectrumZoomIcon {
    color: {{accent}};
    font-size: 20px;
    background: transparent;
    max-width: 24px;
}

#SpectrumSensitivitySlider {
    background: transparent;
    min-width: 20px;
    max-width: 28px;
}

#SpectrumUnitLabel {
    font-size: 8pt;
    color: {{textMuted}};
    font-weight: bold;
    padding-bottom: 2px;
}

#SpectrumSensitivitySlider::groove:vertical {
    background: {{groove}};
    width: 4px;
    border-radius: 2px;
}

#SpectrumSensitivitySlider::handle:vertical {
    background: {{accent}};
    border: 1px solid {{accent}};
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

Host--UI--Spectrum--SpectrumPlotView {
    background-color: transparent;
    alternate-background-color: {{plotBg}};
    border: none;
    color: {{grid}};
    selection-background-color: {{accent}};
}

Host--UI--Spectrum--SpectrumAxisX, Host--UI--Spectrum--SpectrumAxisY {
    font-size: 8pt;
    color: {{textMuted}};
}

#SpectrumWelcomeLabel {
    font-size: 14pt;
    color: {{textDim}};
    font-weight: bold;
}

#effectItemBox {
    background-color: {{panel}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 8px;
}

#effectItemBox:hover {
    border: 1px solid {{accent}};
    background-color: {{panelHover}};
}

#effectDragHandle {
    background-color: transparent;
    selection-background-color: {{accent}};
}

#effectDropIndicator {
    background-color: {{accent}};
    border-radius: 1px;
}

Host--UI--Effects--ParameterItem QLabel {
    color: {{text}};
    font-size: 8pt;
    font-weight: bold;
}

Host--UI--Effects--ParameterItem QSlider::groove:horizontal {
    background: {{groove}};
    height: 4px;
    border-radius: 2px;
}

Host--UI--Effects--ParameterItem QSlider::handle:horizontal {
    background: {{accent}};
    border: 1px solid {{accent}};
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

Host--UI--Effects--ParameterItem QSlider::handle:horizontal:hover {
    background: {{accentHover}};
    border: 1px solid {{accentHover}};
}

#masterVolumeBox {
    background-color: {{panel}};
    border: 1px solid {{border}};
    border-radius: 8px;
}

#masterVolumeBox:hover {
    border: 1px solid {{accent}};
    background-color: {{panelHover}};
}

#masterVolumeTitle {
    color: {{accent}};
    font-weight: bold;
    font-size: 8pt;
}

#masterVolumeValue {
    color: {{text}};
    font-size: 8pt;
    font-weight: bold;
}

#masterVolumeSlider {
    background: transparent;
    min-width: 20px;
    max-width: 28px;
}

#masterVolumeSlider::groove:vertical {
    background: {{groove}};
    width: 4px;
    border-radius: 2px;
}

#masterVolumeSlider::handle:vertical {
    background: {{accent}};
    border: 1px solid {{accent}};
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

#masterVolumeSlider::handle:vertical:hover {
    background: {{accentHover}};
    border: 1px solid {{accentHover}};
}
