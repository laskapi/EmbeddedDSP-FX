/* EmbeddedDSP-FX Stylesheet - Source of Truth */

Host--UI--Spectrum--SpectrumPanel {
    background-color: transparent;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 12px;
}

#SpectrumZoomIcon {
    color: #50c88c;
    font-size: 20px;
    background: transparent;
    max-width: 24px;
}

#SpectrumSensitivitySlider {
    background: transparent;
    min-width: 20px;
    max-width: 28px;
}

#SpectrumUnitLabel {
    font-size: 8pt;
    color: #888888;
    font-weight: bold;
    padding-bottom: 2px;
}

#SpectrumSensitivitySlider::groove:vertical {
    background: #1a1a1a;
    width: 4px;
    border-radius: 2px;
}

#SpectrumSensitivitySlider::handle:vertical {
    background: #50c88c;
    border: 1px solid #50c88c;
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

Host--UI--Spectrum--SpectrumPlotView {
    background-color: transparent;
    alternate-background-color: #000000;  /* Inner Plot Area */
    border: none;
    color: #333333;                       /* Grid Lines (WindowText) */
    selection-background-color: #50c88c;  /* FFT Curve (Highlight) */
}

Host--UI--Spectrum--SpectrumAxisX, Host--UI--Spectrum--SpectrumAxisY {
    font-size: 8pt;
    color: #888888;
}

#SpectrumWelcomeLabel {
    font-size: 14pt;
    color: #aaaaaa;
    font-weight: bold;
}

#effectItemBox {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-bottom: 2px solid #1a1a1a;
    border-radius: 8px;
    padding: 8px;
}

#effectTitle {
    background-color: #1a1a1a;
    color: #50c88c;
    font-weight: bold;
    font-size: 8pt;
    text-transform: uppercase;
    padding: 6px;
    border-radius: 4px;
    margin-bottom: 8px;
}

#effectItemBox:hover {
    border: 1px solid #50c88c;
    background-color: #303030;
}

/* Styl dla etykiet parametrów wewnątrz slotów */
Host--UI--Effects--ParameterItem QLabel {
    color: #e0e0e0;
    font-size: 8pt;
    font-weight: bold;
}

/* Styl dla suwaków wewnątrz slotów */
Host--UI--Effects--ParameterItem QSlider::groove:horizontal {
    background: #1a1a1a;
    height: 4px;
    border-radius: 2px;
}

Host--UI--Effects--ParameterItem QSlider::handle:horizontal {
    background: #50c88c;
    border: 1px solid #50c88c;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

Host--UI--Effects--ParameterItem QSlider::handle:horizontal:hover {
    background: #70dbaf;
    border: 1px solid #70dbaf;
}
